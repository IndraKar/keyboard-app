# Copy to .env for local development. Never commit the real file.

# ---- required in production -------------------------------------------------
# Postgres. Without it the server runs on an in-memory store and forgets every
# subscription when it restarts.
DATABASE_URL=postgres://user:pass@localhost:5432/keyvoria

# Signs session tokens. Any long random string; `openssl rand -hex 32` is fine.
# Changing it signs everyone out.
KEYVORIA_SESSION_SECRET=

# ---- Stripe -----------------------------------------------------------------
# Secret key from the Stripe dashboard. sk_test_... until you are ready to
# charge real cards; sk_live_... after.
STRIPE_SECRET_KEY=

# The recurring $5.95/month price you created in Stripe. Starts with price_,
# NOT prod_ — a product is not a price.
STRIPE_PRICE_ID=

# From `stripe listen` locally, or from the webhook endpoint you add in the
# dashboard. Without it, signed deliveries are rejected and nobody's payment is
# ever recorded.
STRIPE_WEBHOOK_SECRET=

# Where Stripe returns the customer after checkout. Defaults to this server's
# own origin, which is only right if the app is served from it.
KEYVORIA_SUCCESS_URL=
KEYVORIA_CANCEL_URL=

# ---- optional ---------------------------------------------------------------
PORT=8787
# Lock this to your site's origin in production rather than leaving it open.
KEYVORIA_ALLOWED_ORIGIN=*

# ---- development only — never set these in production ------------------------
# Accepts "Bearer dev:<anyUserId>" as that user, and enables /v1/dev/subscribe.
# KEYVORIA_DEV_AUTH=1
# Accepts unsigned webhooks. Anyone who finds the URL could grant themselves a plan.
# KEYVORIA_ALLOW_UNSIGNED_WEBHOOKS=1
